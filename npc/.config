# CONFIG_ISA_mips32 is not set
CONFIG_ISA_riscv=y
CONFIG_ISA="riscv32"

#
# ISA-dependent Options for riscv
#
# CONFIG_RV64 is not set
CONFIG_RVE=y
# end of ISA-dependent Options for riscv

# CONFIG_CC_O0 is not set
# CONFIG_CC_O1 is not set
CONFIG_CC_O2=y
# CONFIG_CC_O3 is not set
CONFIG_CC_OPT="-O2"

#
# Verilator Simulation
#
# CONFIG_WAVE_DUMP is not set
# end of Verilator Simulation

#
# Testing and Debugging
#
CONFIG_TRACE=y
CONFIG_TRACE_START=1000
CONFIG_TRACE_END=10000
# CONFIG_MTRACE is not set
# CONFIG_DIFFTEST is not set
CONFIG_DIFFTEST_REF_PATH="none"
CONFIG_DIFFTEST_REF_NAME="none"
# end of Testing and Debugging

#
# Memory Configuration
#
CONFIG_MBASE=0x80000000
CONFIG_MSIZE=0x8000000
CONFIG_PC_RESET_OFFSET=0
# CONFIG_PMEM_MALLOC is not set
CONFIG_PMEM_GARRAY=y
# end of Memory Configuration

CONFIG_DEVICE=y
CONFIG_HAS_SERIAL=y
CONFIG_SERIAL_MMIO=0xa00003f8
# CONFIG_SERIAL_INPUT_FIFO is not set
CONFIG_HAS_TIMER=y
CONFIG_RTC_MMIO=0xa0000048
CONFIG_HAS_KEYBOARD=y
CONFIG_I8042_DATA_MMIO=0xa0000060
CONFIG_HAS_VGA=y
CONFIG_FB_ADDR=0xa1000000
CONFIG_VGA_CTL_MMIO=0xa0000100
CONFIG_VGA_SHOW_SCREEN=y
CONFIG_VGA_SIZE_400x300=y
# CONFIG_VGA_SIZE_800x600 is not set
CONFIG_HAS_AUDIO=y
CONFIG_SB_ADDR=0xa1200000
CONFIG_SB_SIZE=0x10000
CONFIG_AUDIO_CTL_MMIO=0xa0000200
CONFIG_HAS_DISK=y
CONFIG_DISK_CTL_MMIO=0xa0000300
CONFIG_DISK_IMG_PATH=""
# CONFIG_HAS_SDCARD is not set
